+    @staticmethod
+    def _reference_simpson(y, x):
+        # Composite odd-sample Simpson plus the last-interval quadratic
+        # integral. Derive the last three weights by integrating the Lagrange
+        # basis on [x[-2], x[-1]]; no current SciPy implementation is imported.
+        y, x = np.broadcast_arrays(np.asarray(y), np.asarray(x))
+        count = y.shape[-1]
+        if count == 2:
+            return (x[...,1]-x[...,0])*(y[...,1]+y[...,0])/2.0
+        if count % 2:
+            return integrate.simps(y, x=x)
+        a = x[...,-2]-x[...,-3]
+        b = x[...,-1]-x[...,-2]
+        last = (-b**3/(6*a*(a+b))*y[...,-3]
+                +(b/2+b**2/(6*a))*y[...,-2]
+                +b*(2*b+3*a)/(6*(a+b))*y[...,-1])
+        return integrate.simps(y[...,:-1], x=x[...,:-1])+last
