+    def _reference_top_hat_variance(self):
+        """Integrate raw WDM power under a radius 8 Mpc/h spherical top-hat.
+
+        Returns
+        -------
+        float
+            Dimensionless zero-redshift variance of the unnormalized q10
+            spectrum on the original finite table domain.
+
+        Notes
+        -----
+        Integrate each original interpolation interval using adaptive
+        QUADPACK. The window uses the independent spherical-Bessel formula.
+        This reference imports neither the current W product nor ITAMAE.
+        """
+        from scipy.special import spherical_jn
+
+        def integrand(log_k):
+            """Weight the raw dimensionless power by the spherical window.
+
+            Parameters
+            ----------
+            log_k : float
+                Natural logarithm of k in h/Mpc.
+
+            Returns
+            -------
+            float
+                Contribution to the top-hat variance per dln(k).
+            """
+            x = 8.0*np.exp(log_k)
+            window = 3.0*spherical_jn(1, x)/x
+            return self._reference_integrand(log_k)*window**2
+
+        return sum(integrate.quad(integrand, left, right,
+                   epsabs=1.0e-16, epsrel=2.0e-12)[0]
+                   for left, right in zip(self._reference_log_k[:-1],
+                                          self._reference_log_k[1:]))
